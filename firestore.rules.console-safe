rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /meta/counters {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.nextOrder == 1;
      allow update: if isSignedIn()
        && request.resource.data.nextOrder == resource.data.nextOrder + 1;
    }
    match /meta/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }
    // Orders are now created SERVER-SIDE ONLY, by the admin SDK after a verified
    // Razorpay payment (see src/lib/server/paymentIntents.ts) — the admin SDK
    // bypasses these rules, so denying client `create` here just closes the
    // leftover client-write path.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payment intents — server-only (admin SDK bypasses this).
    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }

    // Razorpay webhook dedupe log — server-only.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Per-customer order-creation rate limit — server-only (admin SDK bypasses
    // this). Written only by enforceOrderRateLimit in create-order.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // Per-item order-quantity tracking + availability config, one doc per
    // menu item (menuConfig/{menuId}). Public read so customers see
    // availability without signing in; only admins can edit limits/overrides
    // or reset counters. Increments happen server-side (admin SDK, bypasses
    // rules) inside finalizePayment's transaction.
    match /menuConfig/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Centralized platform audit logs — read and written by admins
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}