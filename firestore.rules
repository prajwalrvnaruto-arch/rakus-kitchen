rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Order counter (generating RK-xxxxx ids). Any signed-in customer may
    // increment it by exactly one — all other meta docs stay admin-only.
    match /meta/counters {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.nextOrder == 1;
      allow update: if isSignedIn()
        && request.resource.data.nextOrder == resource.data.nextOrder + 1;
    }
    match /meta/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Admin allowlist — keyed by uid, e.g. admins/i06MiYnQCIaNYKGcYtRBaokQC7G3
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Customers own/read their own orders; admins read every order and can update status.
    // Orders are now created SERVER-SIDE ONLY, by the admin SDK after a verified
    // Razorpay payment (see src/lib/server/paymentIntents.ts) — the admin SDK
    // bypasses these rules entirely, so denying client `create` here just closes
    // the leftover client-write path (no legitimate client write should ever
    // reach this rule).
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payment intents hold a server-recomputed order draft between "Razorpay
    // order created" and "payment verified" — never read or written by a
    // client directly, only by the admin SDK (which bypasses rules).
    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }

    // Dedupe log for Razorpay webhook deliveries — server-only.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Per-customer order-creation rate limit (rateLimits/{uid}) — holds recent
    // create-order attempt timestamps. Written only by the admin SDK in
    // enforceOrderRateLimit (see src/lib/server/paymentIntents.ts), which
    // bypasses rules — so no client should ever read or write it directly.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}