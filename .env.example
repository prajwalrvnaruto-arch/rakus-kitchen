# Raku's Kitchen — Environment Variables Template
# Copy this to .env.local for local development. Never commit real credentials!

# ── Frontend Firebase Config (Safe for browser) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_EMULATOR=false

# ── Firebase Admin SDK (Server-Side Only - Secret) ───────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Third-Party Partner Integrations (Server-Side Only - Secret) ─────────────
OLA_MAPS_API_KEY=
BORZO_API_KEY=
BORZO_API_BASE=https://robot-in.borzodelivery.com/api/business/1.8
FAST2SMS_API_KEY=
FAST2SMS_SECRET_SALT=

# ── Payment Gateway (Server-Side Only - Secret) ──────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# Legacy Dev Payment (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
