# Rename this file to .env.local and fill in your Firebase web app config.
# Get these from Firebase Console → Project settings → Your apps → Web app → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# When true, the app talks to the local Firebase emulators (auth + firestore)
# instead of your real project. Great for testing login & orders offline.
# Requires Java installed on the machine and `npm run emulators`.
NEXT_PUBLIC_EMULATOR=false

# ── Ola Maps (Reverse Geocode + Autocomplete) ─────────────────────────────
# Get your API key from https://maps.olakrutrim.com (Krutrim Cloud console).
# Used server-side only (src/lib/olaMaps.ts) — never exposed to the browser.
OLA_MAPS_API_KEY=

# ── Borzo 1-Click Delivery API (Free Onboarding) ─────────────────────────
# Get your free token from https://apitest.borzodelivery.com or https://borzodelivery.com/in/
BORZO_API_KEY=
# Test sandbox URL: https://robotapitest-in.borzodelivery.com/api/business/1.8
# Live production URL: https://robot-in.borzodelivery.com/api/business/1.8
BORZO_API_BASE=https://robot-in.borzodelivery.com/api/business/1.8

# ── Razorpay (mandatory prepay) ───────────────────────────────────────────
# Get all three from https://dashboard.razorpay.com → Settings → API Keys
# (use the "Test Mode" toggle while developing — test keys start with rzp_test_).
# SECRET — server-only, never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SECRET — set under Settings → Webhooks when you add the webhook endpoint
# (POST https://<your-domain>/api/payments/webhook). Deliberately a different
# secret from RAZORPAY_KEY_SECRET so a leak of one doesn't expose the other.
RAZORPAY_WEBHOOK_SECRET=
# PUBLIC — safe to expose. Mirrors RAZORPAY_KEY_ID for the Checkout.js widget
# running in the browser. Keep this in sync with RAZORPAY_KEY_ID above.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Firebase Admin SDK (server-side order creation) ───────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Downloads a JSON file — copy these three fields from it.
# ALL THREE ARE SECRET — never expose to the browser, never commit the JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key field's value as-is; if your shell/host requires a
# single-line value, replace real newlines with the literal characters \n —
# the app un-escapes them at startup (see src/lib/server/firebaseAdmin.ts).
FIREBASE_ADMIN_PRIVATE_KEY=